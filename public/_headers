# Security headers, applied by Cloudflare Pages to every response (docs/SECURITY.md).
# The build replaces %SUPABASE_ORIGIN% with the origin of VITE_SUPABASE_URL (or removes it when sync is
# not configured); `npm run preview` serves the same result, so what is tested locally is what is deployed.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' %SUPABASE_ORIGIN% https://world.openfoodfacts.org; manifest-src 'self'; worker-src 'self'; media-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
