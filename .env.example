# Copy to .env.local for local development, and set the same two variables in your hosting
# (Cloudflare Pages: Settings, Variables and Secrets) for production builds.
# Both values are public by design (they ship in the app's JavaScript); row level security protects
# the data. Leave them empty to build a local-only app without sync.
#
# Never put the Supabase secret / service_role key in this file or anywhere in the app.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
